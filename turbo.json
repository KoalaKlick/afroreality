{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_URL",
    "JWT_SECRET",
    "BASE_URL",
    "FRONTEND_URL",
    "NEXT_PUBLIC_APP_URL",
    "BREVO_API_KEY",
    "BREVO_SENDER_EMAIL",
    "BREVO_SENDER_NAME",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "PAYSTACK_SECRET_KEY",
    "PAYSTACK_PUBLIC_KEY",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY",
    "R2_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_ENDPOINT",
    "R2_PUBLIC_URL_PREFIX",
    "R2_SECRET_KEY",
    "TICKET_SECRET_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM_NAME",
    "SMTP_FROM_EMAIL",
    "SPRING_SECURITY_USER_NAME",
    "SPRING_SECURITY_USER_PASSWORD",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "NODE_ENV",
    "USSD_ROOT_CODE",
    "NEXT_PUBLIC_USSD_ROOT_CODE",
    "NEXTAUTH_SECRET",
    "TICKET_SIGNING_SECRET",
    "NEXT_PUBLIC_R2_PUBLIC_URL",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_PROJ_NAME",
    "PROJ_NAME",
    "FRONTEND_NAME",
    "NEXT_PUBLIC_STORAGE_URL",
    "NEXT_PUBLIC_APP_BASE_URL",
    "NEXT_PUBLIC_DOMAIN_URL",
    "APP_BASE_URL"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_URL",
    "JWT_SECRET",
    "BASE_URL",
    "FRONTEND_URL",
    "NEXT_PUBLIC_APP_URL",
    "BREVO_API_KEY",
    "BREVO_SENDER_EMAIL",
    "BREVO_SENDER_NAME",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "PAYSTACK_SECRET_KEY",
    "PAYSTACK_PUBLIC_KEY",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY",
    "R2_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_ENDPOINT",
    "R2_PUBLIC_URL_PREFIX",
    "R2_SECRET_KEY",
    "TICKET_SECRET_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM_NAME",
    "SMTP_FROM_EMAIL",
    "SPRING_SECURITY_USER_NAME",
    "SPRING_SECURITY_USER_PASSWORD",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "NODE_ENV",
    "USSD_ROOT_CODE",
    "NEXT_PUBLIC_USSD_ROOT_CODE",
    "NEXTAUTH_SECRET",
    "TICKET_SIGNING_SECRET",
    "NEXT_PUBLIC_R2_PUBLIC_URL",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_PROJ_NAME",
    "PROJ_NAME",
    "FRONTEND_NAME",
    "NEXT_PUBLIC_STORAGE_URL",
    "NEXT_PUBLIC_APP_BASE_URL",
    "NEXT_PUBLIC_DOMAIN_URL",
    "APP_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}

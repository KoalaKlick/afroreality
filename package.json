{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy:web": "pnpm --filter web deploy:cloudflare",
    "deploy:workers:all": "pnpm deploy:worker:ussd && pnpm deploy:worker:paystack && pnpm deploy:worker:delivery",
    "deploy:worker:ussd": "cd workers/ussd && wrangler deploy",
    "deploy:worker:paystack": "cd workers/paystack-webhook && wrangler deploy",
    "deploy:worker:delivery": "cd workers/background-delivery && wrangler deploy"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.10.12",
    "wrangler": "^3.114.17"
  },
  "packageManager": "pnpm@11.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "workerd",
      "@cloudflare/workerd-linux-64"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.6.1",
    "pg": "^8.23.0"
  }
}

{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:migrate:deploy": "pnpm --filter @repo/db db:migrate:deploy",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "deploy:workers:all": "pnpm deploy:worker:ussd && pnpm deploy:worker:paystack && pnpm deploy:worker:delivery",
    "deploy:worker:ussd": "cd workers/ussd && wrangler deploy",
    "deploy:worker:paystack": "cd workers/paystack-webhook && wrangler deploy",
    "deploy:worker:delivery": "cd workers/background-delivery && wrangler deploy"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.10.12",
    "wrangler": "^3.114.17"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.6.1",
    "pg": "^8.23.0"
  }
}
